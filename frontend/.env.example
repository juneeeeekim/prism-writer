# =============================================================================
# PRISM Writer Frontend - Environment Variables Template
# =============================================================================
# 파일: frontend/.env.example
# 역할: 환경 변수 템플릿 (실제 값으로 교체 후 .env.local로 저장)
# 보안: 이 파일은 커밋해도 됨, .env.local 파일은 절대 커밋 금지!
# 갱신: 2026-03-05 Health Audit — 전체 환경변수 문서화 (59개)
# =============================================================================

# =============================================================================
# [CORE] 기본 설정
# =============================================================================
NEXT_PUBLIC_APP_NAME=PRISM Writer
NEXT_PUBLIC_SITE_URL=https://prism-writer.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# [E2E] 실제 연동 테스트 설정 (값 존재 여부만 로그에 출력, secret 출력 금지)
# =============================================================================
E2E_BACKEND_URL=http://localhost:8000
E2E_FRONTEND_URL=http://localhost:3000
# external-smoke는 외부 비용/데이터 변경 위험이 있으므로 명시 승인 시에만 실행
E2E_EXTERNAL_SMOKE=0
ALLOW_EXTERNAL_SMOKE=false
E2E_EXTERNAL_BASE_URL=
E2E_COST_LIMIT_USD=
E2E_MAX_TOKENS=
E2E_PREFLIGHT_TIMEOUT_MS=5000

# =============================================================================
# [SUPABASE] 데이터베이스 & 인증
# =============================================================================
# 클라이언트용 (anon key — 공개 가능)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 서버 전용 (비밀 키 — 절대 공개 금지!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# [LLM] API Keys (서버사이드 전용)
# =============================================================================
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =============================================================================
# [EXTERNAL] 외부 서비스 API Keys
# =============================================================================
# Tavily — Deep Scholar 학술/정부 검색용 (비밀 키)
TAVILY_API_KEY=your-tavily-api-key-here

# Brave Search — 일반 웹 검색용 (비밀 키)
BRAVE_API_KEY=your-brave-api-key-here

# =============================================================================
# [CRON] 스케줄 작업 보안
# =============================================================================
CRON_SECRET=your-cron-secret-here

# =============================================================================
# [LLM CONFIG] LLM 모델 설정 (서버사이드)
# =============================================================================
# 기본 모델 오버라이드 (비워두면 config/models.ts의 isDefault 모델 사용)
DEFAULT_MODEL=
# 활성 프로바이더 목록 (비워두면 모든 프로바이더 활성)
ENABLED_PROVIDERS=

# =============================================================================
# [LLM USAGE OVERRIDE] 컨텍스트별 모델 오버라이드 (선택)
# 설계 의도:
#   각 컨텍스트(rag.answer 등)별 모델을 코드 변경 없이 ENV로 교체할 수 있다.
#   잘못된 모델 ID는 자동 무시되고 경고만 남는다(런타임 안정성 우선).
#   키 규칙: MODEL_<CONTEXT_UPPER_SNAKE>  (예: rag.answer → MODEL_RAG_ANSWER)
# =============================================================================
# RAG Pipeline
# MODEL_RAG_ANSWER=
# MODEL_RAG_REVIEWER=
# MODEL_RAG_RERANKER=
# MODEL_RAG_RERANK=
# MODEL_RAG_SELFRAG=
# MODEL_RAG_CHUNKING=

# Template System (Gates)
# MODEL_TEMPLATE_CONSISTENCY=
# MODEL_TEMPLATE_HALLUCINATION=
# MODEL_TEMPLATE_REGRESSION=

# Mining Features
# MODEL_EXAMPLE_MINING=
# MODEL_RULE_MINING=
# MODEL_PATTERN_EXTRACTION=

# Premium Tier
# MODEL_PREMIUM_ANSWER=
# MODEL_PREMIUM_REVIEWER=

# Suggestion / Research / Judge
# MODEL_SUGGEST_COMPLETION=
# MODEL_RESEARCH_QUERY=
# MODEL_RESEARCH_SUMMARIZE=
# MODEL_JUDGE_ALIGN=
# MODEL_JUDGE_HOLISTIC=

# Outline / OCR / Coach
# MODEL_OUTLINE_GENERATION=
# MODEL_OCR_VISION=
# MODEL_COACH_STYLE_ANALYSIS=
# MODEL_COACH_PERSONA_FEEDBACK=

# RAFT
# MODEL_RAFT_GENERATION=

# =============================================================================
# [ERROR LOG] 에러 로그 저장 설정 (선택)
# =============================================================================
# 로그 루트 경로(기본: <repo>/error-log).
# 컨테이너/서버리스 환경에서는 쓰기 가능한 임시 경로를 지정.
# ERROR_LOG_ROOT=
# 로그 쓰기 타임아웃 (ms, 기본 1000, 최대 10000)
# ERROR_LOG_WRITE_TIMEOUT_MS=

# =============================================================================
# [FEATURE FLAGS — SERVER] 서버사이드 기능 플래그
# NEXT_PUBLIC_ 접두사 없음 — 서버에서만 접근 가능
# =============================================================================

# --- 파이프라인 버전 ---
ENABLE_PIPELINE_V4=false
ENABLE_PIPELINE_V5=true

# --- LLM 프로바이더 ---
ENABLE_GEMINI_LLM=true

# --- RAG 기능 ---
ENABLE_DUAL_INDEX=false
ENABLE_SHADOW_WORKSPACE=false
ENABLE_PATCH_SUGGESTIONS=false
ENABLE_QUERY_EXPANSION=false
ENABLE_HALLUCINATION_DETECTION=false
ENABLE_SOURCE_CITATIONS=false
ENABLE_SHADOW_MODE=false
ENABLE_IMPROVED_PROMPT=true

# --- 세션 & 인증 ---
ENABLE_ASSISTANT_SESSIONS=true
SKIP_RAFT_AUTH=false

# --- RAFT ---
ENABLE_RAFT_FEATURES=false

# --- 실험적 플래그 ---
FF_PATCH_STAGING=false
FF_EVIDENCE_QUALITY=false
USE_TEMPLATE_FOR_CHAT=false

# --- 디버그 ---
ENABLE_DEBUG_LOGS=false

# =============================================================================
# [FEATURE FLAGS — CLIENT] 클라이언트사이드 기능 플래그
# NEXT_PUBLIC_ 접두사 — 브라우저에서도 접근 가능
# =============================================================================

# --- 채팅 ---
NEXT_PUBLIC_ENABLE_CHAT_HISTORY=true
NEXT_PUBLIC_ENABLE_CHAT_HISTORY_UI=true
NEXT_PUBLIC_ENABLE_CHAT_SESSION_LIST=true

# --- 파이프라인 (클라이언트 미러) ---
NEXT_PUBLIC_ENABLE_PIPELINE_V4=false

# --- 템플릿 ---
NEXT_PUBLIC_USE_V3_TEMPLATES=false

# --- RAG 고급 기능 ---
NEXT_PUBLIC_ENABLE_CITATION_MARKERS=false
NEXT_PUBLIC_ENABLE_PATTERN_EXTRACTION=false
NEXT_PUBLIC_ENABLE_PATTERN_BASED_SEARCH=false
NEXT_PUBLIC_ENABLE_RUBRIC_CANDIDATE_UI=false
NEXT_PUBLIC_ENABLE_QUERY_BUILDER=false
NEXT_PUBLIC_ENABLE_SUFFICIENCY_GATE=false
NEXT_PUBLIC_ENABLE_CRITERIA_PACK=false
NEXT_PUBLIC_ENABLE_PIN_UNPIN=false

# --- 검색 개선 ---
NEXT_PUBLIC_ENABLE_WEIGHTED_HYBRID_SEARCH=false
NEXT_PUBLIC_ENABLE_RERANKING=false
NEXT_PUBLIC_RERANK_MODEL=
NEXT_PUBLIC_RERANK_TOP_CANDIDATES=

# --- Agentic Chunking ---
NEXT_PUBLIC_ENABLE_AGENTIC_CHUNKING=false
NEXT_PUBLIC_AGENTIC_CHUNKING_MODEL=

# --- Self-RAG ---
NEXT_PUBLIC_ENABLE_SELF_RAG=true
NEXT_PUBLIC_SELF_RAG_MODEL=
NEXT_PUBLIC_SELF_RAG_RETRIEVAL_THRESHOLD=
NEXT_PUBLIC_SELF_RAG_CRITIQUE_THRESHOLD=

# --- Lazy Self-RAG ---
NEXT_PUBLIC_LAZY_SELF_RAG_MODE=false
NEXT_PUBLIC_LAZY_SELF_RAG_MIN_RESPONSE_LENGTH=
NEXT_PUBLIC_LAZY_SELF_RAG_MIN_QUERY_LENGTH=

# --- AI 작가 도구 ---
NEXT_PUBLIC_ENABLE_AI_STRUCTURER=true
NEXT_PUBLIC_ENABLE_SHADOW_WRITER=false
NEXT_PUBLIC_SHADOW_WRITER_TRIGGER_MODE=
NEXT_PUBLIC_ENABLE_RICH_SHADOW_WRITER=false
NEXT_PUBLIC_ENABLE_DEEP_SCHOLAR=false

# --- 웹 검색 통합 (Brave + Tavily) ---
ENABLE_WEB_SEARCH=false
NEXT_PUBLIC_ENABLE_WEB_SEARCH=false

# =============================================================================
# [DEPRECATED / UNUSED] 미사용 변수 (하위 호환용 보존)
# =============================================================================
# NEXT_PUBLIC_ENABLE_ANALYTICS=false    # (미사용 — 코드에서 참조 없음)
# NEXT_PUBLIC_ENABLE_DEBUG_MODE=true    # (미사용 — 코드에서 참조 없음)
